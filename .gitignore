# ============================================================
# CYBERDECK PORTFOLIO - Git Ignore Rules
# ============================================================

# Private personal project data, configuration & media (excluded from GitHub)
data/config.php
data/profile.json
data/projects.json
data/documents_extracted.json
data/system_prompt.php
data/.key_state.json
data/.rate_limits.json
# Ignore private media in data/img/, allow example media
data/img/**
!data/img/**/
!data/img/**/*example*

# Ignore private documents/attachments in data/files/, allow example files & setup readme
data/files/**
!data/files/**/
!data/files/**/*example*
!data/files/AI-COMM-Chat-Setup-Readme.txt


config.php
.env
.env.local

# Optional local overrides
data/*.local.*
*.local.*

# Internal planning documents & concepts
/intern/

# Optional private avatar overrides
assets/img/*.local.*
assets/img/*.private.*
assets/img/portrait.jpg

# Temporary cache & logs
cache/
*.log

# OS & IDE metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
